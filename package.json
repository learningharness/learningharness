{
  "name": "learningharness",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test packages/*/test/*.test.js adapters/*/test/*.test.js",
    "build:codex": "vite build --config adapters/codex/vite.config.mjs",
    "eval:dontdumb": "node scripts/evals/run.mjs",
    "package:codex:native": "node scripts/package-native-codex.mjs",
    "test:codex:package": "node --test scripts/codex-release/package.test.mjs",
    "eval:learning-value": "node scripts/evals/learning-value.mjs",
    "typecheck": "tsc -p packages/ui/tsconfig.json --noEmit",
    "build": "vite build --config scripts/desktop-runtime/vite.config.mjs",
    "test:desktop": "node --test scripts/desktop-runtime/*.test.mjs scripts/codex-release/*.test.mjs scripts/claude-release/early-context.test.mjs scripts/claude-release/launcher-control.test.mjs",
    "pretest": "tsc -p packages/http-retry/tsconfig.json",
    "test:claude:package": "node scripts/claude-release/package.mjs && node --test scripts/claude-release/package.test.mjs",
    "pretest:desktop": "LEARNING_HARNESS_POSTHOG_TOKEN=phc_synthetic_package_test node scripts/package-native-codex.mjs",
    "test:release": "node --test scripts/release/*.test.mjs"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.5.0",
    "@types/d3-hierarchy": "3.1.7",
    "d3-hierarchy": "3.1.3",
    "esbuild": "0.25.12",
    "parse5": "7.2.1",
    "solid-js": "1.9.17",
    "typescript": "5.9.3",
    "vite": "7.1.12",
    "vite-plugin-solid": "2.11.8"
  },
  "description": "Learn from the work you build with coding agents.",
  "license": "MIT",
  "author": "arvindm1991",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/learningharness/learningharness.git"
  },
  "homepage": "https://learningharness.dev",
  "engines": {
    "node": ">=22.19.0"
  }
}
